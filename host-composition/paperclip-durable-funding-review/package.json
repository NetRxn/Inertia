{
  "name": "paperclip-durable-funding-review-qualification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Non-live trusted host qualification. Exact source baseline, not a permanent version policy.",
  "engines": {
    "node": ">=24.11.0"
  },
  "dependencies": {
    "paperclipai": "2026.1012.0"
  },
  "scripts": {
    "bootstrap": "npm ci --ignore-scripts --registry=https://registry.npmjs.org --cache=.cache/npm --no-audit --no-fund && node scripts/bootstrap.mjs && node scripts/apply-plugin-runtime.mjs && node scripts/apply-codex-command-tools.mjs && node scripts/apply-native-coordinator.mjs && node scripts/apply-native-runner-resolution.mjs",
    "verify-and-patch": "node scripts/bootstrap.mjs && node scripts/apply-plugin-runtime.mjs && node scripts/apply-codex-command-tools.mjs && node scripts/apply-native-coordinator.mjs && node scripts/apply-native-runner-resolution.mjs",
    "test": "./tests/with-disposable-pg.sh node --test tests/*.test.mjs",
    "test:launcher": "python3 -m unittest discover -s tests -p test_launcher_safety.py -v",
    "check-upstream": "node scripts/check-upstream.mjs",
    "apply-plugin-runtime": "node scripts/apply-plugin-runtime.mjs",
    "test:plugin-runtime": "node --test tests/plugin-runtime-delivery.test.mjs tests/plugin-runtime-installer.test.mjs",
    "apply-codex-command-tools": "node scripts/apply-codex-command-tools.mjs",
    "test:codex-command-tools": "node --test tests/codex-command-tools.test.mjs tests/codex-command-installer.test.mjs tests/codex-command-capability.test.mjs",
    "apply-mcp-effect-metadata": "node scripts/apply-mcp-effect-metadata.mjs",
    "test:mcp-effect-metadata": "node --test tests/mcp-effect-metadata.test.mjs tests/codex-effect-approval.test.mjs",
    "apply-funding-preapproval": "node scripts/apply-funding-preapproval.mjs",
    "test:funding-preapproval": "node --test tests/funding-preapproval*.test.mjs tests/codex-funding-preapproval.test.mjs",
    "apply-native-coordinator": "node scripts/apply-native-coordinator.mjs",
    "test:native-coordinator": "node --test tests/native-coordinator*.test.mjs",
    "qualify:native-coordinator": "node tests/qualify-native-coordinator.mjs",
    "apply-native-runner-resolution": "node scripts/apply-native-runner-resolution.mjs",
    "test:native-runner": "node --test tests/native-runner-*.test.mjs tests/native-coordinator*.test.mjs",
    "preflight:native-runner": "node scripts/preflight-native-runner.mjs",
    "test:funding-package": "node --test packaging/funding-only.test.mjs",
    "apply-funding-deadline": "node scripts/apply-funding-deadline.mjs",
    "test:funding-deadline": "node --test tests/funding-deadline*.test.mjs tests/codex-funding-preapproval.test.mjs",
    "apply-native-reconciliation": "node scripts/apply-native-reconciliation.mjs",
    "test:native-reconciliation": "node --test tests/native-reconciliation-cancel.test.mjs tests/native-reconciliation-installer.test.mjs",
    "apply-agent-tool-use-restrictions": "node scripts/apply-agent-tool-use-restrictions.mjs",
    "test:agent-tool-use-restrictions": "node --test tests/agent-tool-use-restrictions*.test.mjs tests/funding-role-catalog.test.mjs",
    "apply-native-recovery-handback": "node scripts/apply-native-recovery-handback.mjs",
    "test:native-recovery-handback": "node --test tests/native-recovery-handback*.test.mjs",
    "apply-native-funding-profile": "node scripts/apply-native-funding-profile.mjs",
    "test:native-funding-profile": "node --test tests/native-funding-policy.test.mjs tests/native-funding-roundtrip.test.mjs tests/native-funding-installer.test.mjs",
    "qualify:native-funding-profile": "node tests/qualify-native-funding.mjs",
    "apply-native-attention-deadline": "node scripts/apply-native-attention-deadline.mjs",
    "test:native-attention-deadline-installer": "node --test tests/native-attention-deadline-installer.test.mjs",
    "apply-native-domain-review": "node scripts/apply-native-domain-review.mjs",
    "test:native-domain-review": "node --test tests/native-domain-review*.test.mjs tests/native-review-*.test.mjs",
    "apply-native-discovery-profile": "node scripts/apply-native-discovery-profile.mjs",
    "test:native-discovery-profile": "node --test tests/native-discovery-profile.test.mjs tests/native-discovery-installer.test.mjs"
  }
}
