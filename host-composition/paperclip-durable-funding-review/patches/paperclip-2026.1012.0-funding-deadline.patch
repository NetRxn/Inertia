+import { FUNDING_ROLE_TOOLS, resolveFundingToolPreapproval } from './funding-tool-preapproval.js';
+
+// Host-owned resource limits, not permissions or caller-provided configuration.
+export const FUNDING_EXECUTION_BUDGET = Object.freeze({
+    operationTimeoutMs: 120_000,
+    rpcTimeoutMs: 160_000,
+    gatewayTimeoutMs: 170_000,
+    clientToolTimeoutSec: 180,
+});
+const exactSet = (actual, expected) => Array.isArray(actual) &&
+    actual.length === expected.length && new Set(actual).size === actual.length &&
+    actual.every(name => expected.includes(name));
+
+/** Longer budgets apply only to a complete role-only native assignment. */
+export function hasExactFundingExecutionCatalog(approval, assignment) {
+    if (!approval || approval.version !== 1 || !Object.hasOwn(FUNDING_ROLE_TOOLS, approval.role)) return false;
+    const names = FUNDING_ROLE_TOOLS[approval.role];
+    return assignment?.version === 1 && assignment.agentId === approval.agentId &&
+        Array.isArray(assignment.connections) && assignment.connections.length === 0 &&
+        Array.isArray(assignment.tools) && assignment.tools.length === 0 &&
+        exactSet(assignment.pluginTools, names) && exactSet(approval.tools, names);
+}
+
+export async function resolveFundingExecutionPolicy(db, input) {
+    if (!input.assignment?.valid || typeof input.toolName !== 'string' ||
+        !Number.isSafeInteger(input.startedAt) || input.startedAt > Date.now()) return null;
+    const approval = await resolveFundingToolPreapproval(db, {
+        companyId: input.companyId, agentId: input.agentId, runId: input.runId,
+        assignedTools: input.assignment.names,
+    });
+    if (!hasExactFundingExecutionCatalog(approval, input.assignment.pinned) ||
+        !approval.tools.includes(input.toolName)) return null;
+    return Object.freeze({
+        version: 1, role: approval.role,
+        companyId: approval.companyId, agentId: approval.agentId, runId: approval.runId,
+        issueId: approval.issueId, projectId: approval.projectId,
+        toolName: input.toolName, invocationId: input.invocationId,
+        startedAt: input.startedAt,
+        operationDeadlineAt: input.startedAt + FUNDING_EXECUTION_BUDGET.operationTimeoutMs,
+        rpcDeadlineAt: input.startedAt + FUNDING_EXECUTION_BUDGET.rpcTimeoutMs,
+        gatewayDeadlineAt: input.startedAt + FUNDING_EXECUTION_BUDGET.gatewayTimeoutMs,
+    });
+}
+
+const fields = ['version','role','companyId','agentId','runId','issueId','projectId',
+    'toolName','invocationId','startedAt','operationDeadlineAt','rpcDeadlineAt','gatewayDeadlineAt'];
+const uuid = value => typeof value === 'string' && /^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i.test(value);
+/** Internal dispatch metadata is accepted only from the verified gateway path. */
+export function validateFundingExecutionPolicy(policy, toolName, runContext) {
+    if (Object.hasOwn(runContext, 'fundingExecution')) throw Error('Caller-supplied funding execution metadata refused');
+    if (policy === undefined || policy === null) return null;
+    if (!policy || typeof policy !== 'object' || Array.isArray(policy) ||
+        Object.keys(policy).length !== fields.length || fields.some(key => !Object.hasOwn(policy,key)) ||
+        policy.version !== 1 || !Object.hasOwn(FUNDING_ROLE_TOOLS, policy.role) ||
+        !FUNDING_ROLE_TOOLS[policy.role].includes(toolName) || policy.toolName !== toolName ||
+        !['companyId','agentId','runId','issueId','projectId','invocationId'].every(key => uuid(policy[key])) ||
+        !['companyId','agentId','runId','projectId'].every(key => policy[key] === runContext[key]) ||
+        !Number.isSafeInteger(policy.startedAt) || policy.startedAt > Date.now() ||
+        policy.operationDeadlineAt !== policy.startedAt + FUNDING_EXECUTION_BUDGET.operationTimeoutMs ||
+        policy.rpcDeadlineAt !== policy.startedAt + FUNDING_EXECUTION_BUDGET.rpcTimeoutMs ||
+        policy.gatewayDeadlineAt !== policy.startedAt + FUNDING_EXECUTION_BUDGET.gatewayTimeoutMs)
+        throw Error('Invalid trusted funding execution policy');
+    if (policy.operationDeadlineAt <= Date.now()) throw Error('Funding operation deadline exhausted before dispatch; no child started');
+    return policy;
+}
