+import type { Db } from '@paperclipai/db';
+import type { IssueThreadInteractionServiceOptions } from './issue-thread-interactions.js';
+type Transaction = Parameters<Parameters<Db['transaction']>[0]>[0];
+export interface FundingReviewBinding {
+    companyId: string; issueId: string; interactionId: string; itemId: string;
+    applicantId: string; targetId: string; targetVersion: number;
+    kind: 'proposal' | 'packet_role'; reviewerUserId: string;
+    reviewerRole: 'program' | 'fiscal' | 'legal_compliance' | 'partner' | 'authorized_representative';
+    expectedHead: string; expectedWorkspaceHash: string; sourceScope: string;
+    allowedEvidenceIds: readonly string[]; allowedTargets: readonly string[];
+    documentId: string; documentKey: string; documentRevisionId: string; interactionDigest: string;
+}
+export interface FundingReviewCommand {
+    decisionKey: string; binding: FundingReviewBinding; actorUserId: string;
+    action: 'accepted' | 'rejected' | 'approved' | 'changes_requested';
+    reason: string; resolvedAt: string;
+}
+export interface FundingAcceptanceReceipt {
+    schema: 'inertia.funding-acceptance.v1'; acceptanceId: string;
+    command: FundingReviewCommand;
+    /** Native activity timestamp, not a commit-time ordering token. */
+    acceptedAt: string;
+}
+export interface FundingReceiptRetention {
+    /** Trusted host policy only. Must verify immutable acceptance storage plus
+     * approved archive/deletion behavior in this transaction; failure aborts the
+     * native verdict. The shipped qualification guard is NOT a production policy. */
+    assertRetentionInTransaction(tx: Transaction): Promise<void>;
+}
+export declare function createFundingReviewCapture(config: {
+    registrations: readonly FundingReviewBinding[];
+    rolePermissionKeys: Partial<Record<FundingReviewBinding['reviewerRole'],string>>;
+    retention?: FundingReceiptRetention;
+    /** Stable authorized tenant scope for historic replay. Defaults to registration companies. */
+    readCompanyIds?: readonly string[];
+}): {
+    captureInTransaction: NonNullable<IssueThreadInteractionServiceOptions['captureItemVerdictsInTransaction']>;
+    readAcceptance(db: Db, acceptanceId: string): Promise<FundingAcceptanceReceipt | null>;
+    /** Restart full sweeps after every exhausted scan; UUID order is not commit order. */
+    listAcceptances(db: Db, input: {companyId:string;afterId?:string|null;limit?:number}): Promise<{receipts:FundingAcceptanceReceipt[];nextCursor:string|null}>;
+};
