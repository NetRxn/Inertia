+/** Preserve only explicit boolean MCP effect hints. Unknown/malformed metadata stays absent and conservative. */
+export function validatedToolAnnotations(value) {
+    if (!value || typeof value !== "object" || Array.isArray(value)) return undefined;
+    const keys = Object.keys(value);
+    const allowed = ["readOnlyHint", "destructiveHint", "idempotentHint", "openWorldHint"];
+    if (!keys.length || keys.some(key => !allowed.includes(key) || typeof value[key] !== "boolean")) return undefined;
+    return Object.fromEntries(keys.map(key => [key, value[key]]));
+}
