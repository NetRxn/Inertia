+import { toolAccessPolicyService } from "../tool-access-policy.js";
+import { resolveAssignedPluginToolsForRun } from "./assigned-mcp-tools.js";
+export const FUNDING_ROLE_TOOLS = Object.freeze({
+ producer:Object.freeze(["funding_drafting_workspace","save_funding_proposals","save_funding_gap_progress","funding_drafting_checkpoint"].map(n=>"netrxn.inertia:"+n)),
+ reviewer:Object.freeze(["funding_review_context","review_funding_candidate"].map(n=>"netrxn.inertia:"+n)),
+});
+const object=v=>!!v&&typeof v==="object"&&!Array.isArray(v);
+const text=v=>typeof v==="string"&&v.length>0&&v===v.trim();
+/** Only the server-owned company config, stored run/issue and fresh native allow decisions can approve. */
+export async function resolveFundingToolPreapproval(db,input) {
+ if(!input||![input.companyId,input.agentId,input.runId].every(text)||!Array.isArray(input.assignedTools)||input.assignedTools.some(n=>!text(n)))return null;
+ async function state(){
+  const [plugin]=await db.select().from(plugins).where(eq(plugins.pluginKey,"netrxn.inertia")).limit(1);
+  if(!plugin||plugin.status!=="ready")return null;
+  const [disabled]=await db.select().from(pluginCompanySettings).where(and(eq(pluginCompanySettings.pluginId,plugin.id),eq(pluginCompanySettings.companyId,input.companyId))).limit(1);
+  if(disabled?.enabled===false)return null;
+  const [row]=await db.select().from(pluginConfig).where(and(eq(pluginConfig.pluginId,plugin.id),eq(pluginConfig.companyId,input.companyId))).limit(1);
+  const config=row?.configJson,b=config?.publicDrafting;
+  if(config?.nativeFundingToolPreapproval!==true||!object(b)||b.enabled!==true||![b.projectId,b.applicantSlug,b.matchId].every(text))return null;
+  const a=b.producer,z=b.reviewer;
+  if(!object(a)||!object(z)||![a.issueId,a.agentId,a.principalId,z.issueId,z.agentId,z.principalId].every(text)||a.issueId===z.issueId||a.agentId===z.agentId||a.principalId===z.principalId)return null;
+  const role=a.agentId===input.agentId?"producer":z.agentId===input.agentId?"reviewer":null;if(!role)return null;
+  const actor=b[role];
+  const [agent]=await db.select().from(agents).where(and(eq(agents.id,input.agentId),eq(agents.companyId,input.companyId))).limit(1);
+  const cfg=agent?.adapterConfig;
+  if(!agent||!["idle","running"].includes(agent.status)||agent.adapterType!=="codex_local"||cfg?.disableCommandExecution!==true||cfg.engine!=="cli"||cfg.dangerouslyBypassApprovalsAndSandbox!==false||cfg.dangerouslyBypassSandbox===true||[cfg.extraArgs,cfg.args].some(v=>v!==undefined&&(!Array.isArray(v)||v.length)))return null;
+  const [run]=await db.select().from(heartbeatRuns).where(and(eq(heartbeatRuns.id,input.runId),eq(heartbeatRuns.companyId,input.companyId),eq(heartbeatRuns.agentId,input.agentId))).limit(1);
+  if(!run||run.status!=="running"||run.finishedAt)return null;
+  const ids=[run.nativeIssueId,run.contextSnapshot?.issueId,run.contextSnapshot?.taskId].filter(v=>v!=null);
+  if(!ids.length||ids.some(v=>v!==actor.issueId)||run.contextSnapshot?.projectId!=null&&run.contextSnapshot.projectId!==b.projectId)return null;
+  const [issue]=await db.select().from(issues).where(and(eq(issues.id,actor.issueId),eq(issues.companyId,input.companyId))).limit(1);
+  if(!issue||issue.projectId!==b.projectId||issue.assigneeAgentId!==input.agentId||!["todo","in_progress","blocked","in_review"].includes(issue.status)||issue.executionRunId&&issue.executionRunId!==input.runId)return null;
+  return{version:1,role,companyId:input.companyId,agentId:input.agentId,runId:input.runId,issueId:actor.issueId,projectId:b.projectId,configSnapshot:JSON.stringify(b),issueStatus:issue.status};
+ }
+ const before=await state();if(!before)return null;
+ const live=new Set((await resolveAssignedPluginToolsForRun(db,{companyId:input.companyId,agentId:input.agentId,runId:input.runId})).map(t=>t.name));
+ const assigned=new Set(input.assignedTools),tools=[],policy=toolAccessPolicyService(db);
+ for(const name of FUNDING_ROLE_TOOLS[before.role]){
+  if(!assigned.has(name)||!live.has(name))continue;
+  if(before.issueStatus==="in_review"&&!["funding_drafting_workspace","funding_drafting_checkpoint","funding_review_context","review_funding_candidate"].some(n=>name==="netrxn.inertia:"+n))continue;
+  const decision=await policy.decide({companyId:input.companyId,actor:{actorType:"agent",actorId:input.agentId,agentId:input.agentId},runContext:{heartbeatRunId:input.runId,issueId:before.issueId,projectId:before.projectId},request:{toolName:name,upstreamToolName:name,providerType:"paperclip_plugin",riskLevel:"destructive",sideEffecting:true,arguments:{}},consumeRateLimit:false});
+  if(decision.allowed===true&&decision.decision==="allow")tools.push(name);
+ }
+ const after=await state();if(!after||JSON.stringify(before)!==JSON.stringify(after))return null;
+ const {configSnapshot:_,issueStatus:__,...binding}=after;return tools.length?{...binding,tools:tools.sort()}:null;
+}
