+/** Dispatch-only hint, never authentication: a marked token is fully verified
+ * by the real native middleware before any global JSON parser can consume it.
+ * Unmarked/native-compatible credentials keep the original path unchanged. */
+export function hasMemberAttemptMarker(req) {
+    const header = req.header("authorization");
+    try {
+        if (typeof header !== "string" || !/^Bearer\s+/i.test(header)) return false;
+        const parts = header.replace(/^Bearer\s+/i, "").split(".");
+        return parts.length === 3 && JSON.parse(Buffer.from(parts[1], "base64url").toString("utf8"))?.inertia_member_attempt === true;
+    } catch { return false; }
+}
+export function memberAttemptPreparseGuard(db, opts) {
+    const authenticate = actorMiddleware(db, opts);
+    return (req, res, next) => hasMemberAttemptMarker(req) ? authenticate(req, res, next) : next();
+}
