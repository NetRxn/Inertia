flowchart TB
 S["Current sources and permitted SQL evidence"] --> D["Actual system preparation<br/>Near-complete draft and source support"]
 D --> Q{"Independent agent quality review"}
 Q --> D
 Q --> H["Any eligible current DAO member<br/>Current application action access<br/>V2 core merged; action wiring pending"]
 H -.-> P[("Immutable packet/version<br/>Exact artifacts and actual review state")]
 P -.-> G["Actual sponsor or DAO requirements<br/>Only when the real case requires them"]
 P -.-> A["Mark submitted or authenticated Buzz intent<br/>Selected immutable packet and actual date"]
 X["Human external submission<br/>Outside this record action"] -.-> A
 A -.-> R[("Retained submitted record<br/>Reporter and evidence level<br/>Missing approvals remain missing")]
 E["Optional later receipt<br/>Image, email or reference"] -.-> R
 class D,Q core
 class H,A planned
 class P,R store

 classDef core fill:#e7f1ee,stroke:#157d80,color:#132e38,stroke-width:2px
 classDef planned fill:#fffaf0,stroke:#b1853e,color:#132e38,stroke-dasharray:6 4
 classDef reviewed fill:#f5f0ff,stroke:#8064a2,color:#132e38
 classDef store fill:#edf2f7,stroke:#61788b,color:#132e38
