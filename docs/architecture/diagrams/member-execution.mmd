flowchart TB
 subgraph M[Member environment]
 U["DAO member<br/>Operates an approved agent"] --> E["Isolated member runtime<br/>Shared skills and tool schema<br/>Task-scoped evidence"]
 E --> P["Candidate result<br/>Artifacts and source references"]
 end
 subgraph T[Trusted services]
 PC["Paperclip<br/>Task assignment and permitted inputs"]
 V["Server validation<br/>Identity, task revision,<br/>source and artifact checks"]
 A["Review and acceptance<br/>Authorized task update"]
 D["Privileged domain services<br/>Database and publisher credentials"]
 V -->|Validated evidence| A
 A -.->|Authorized domain action| D
 end
 PC -.->|Scoped task| E
 P -.->|Submit candidate| V
 H["Authorized human reviewer"] -.->|Authenticated decision when required| A
 A -.->|Outcome and status| E
 A -->|Accepted task state| PC
 class PC,V,A core
 class E planned

 classDef core fill:#e7f1ee,stroke:#157d80,color:#132e38,stroke-width:2px
 classDef planned fill:#fffaf0,stroke:#b1853e,color:#132e38,stroke-dasharray:6 4
 classDef reviewed fill:#f5f0ff,stroke:#8064a2,color:#132e38
 classDef store fill:#edf2f7,stroke:#61788b,color:#132e38
