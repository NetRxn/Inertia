# Database configuration
# Use DATABASE_URL for node-postgres connection, or leave unset to use PGlite
# DATABASE_URL=postgresql://user:password@localhost:5432/inertia

# PGlite directory (only used when DATABASE_URL is not set)
# MEMBER_APP_PGLITE_DIR=data/pglite

# Chat assistant (Vercel AI SDK; the provider is swappable)
# MEMBER_APP_MODEL_PROVIDER=anthropic          # anthropic | openai-compatible
# MEMBER_APP_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=                           # read by the anthropic provider
# For openai-compatible servers (e.g. a local model):
# MEMBER_APP_MODEL_BASE_URL=http://localhost:11434/v1
# MEMBER_APP_MODEL_API_KEY=
# Tests and e2e only (refused when NODE_ENV=production):
# MEMBER_APP_MODEL_PROVIDER=mock
