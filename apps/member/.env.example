# Inertia member app: environment variables.
# Copy to .env.local (git-ignored) and uncomment what you need. Every variable
# is optional for local development; commented values are the defaults or examples.

# --- Database ---
# A Postgres URL switches the app to node-postgres. Leave unset to use local PGlite.
# DATABASE_URL=postgresql://user:password@localhost:5432/inertia
# PGlite directory, used only when DATABASE_URL is unset.
# MEMBER_APP_PGLITE_DIR=data/pglite

# --- Login ---
# Base URL put into login links.
# MEMBER_APP_BASE_URL=http://localhost:3000
# Where the development mailer writes each login link, as <email>.txt.
# MEMBER_APP_MAIL_DIR=data/dev-mail

# --- Adapters and member sync ---
# Which adapter set backs the outside systems. Only "fixture" exists in v1.
# MEMBER_APP_ADAPTERS=fixture
# Minutes between member syncs from the directory while the server runs.
# MEMBER_SYNC_INTERVAL_MINUTES=15

# --- Shares ---
# Set to "off" to skip fetching link previews (e2e does this).
# MEMBER_APP_LINK_PREVIEWS=on

# --- Chat assistant (Vercel AI SDK; the provider is swappable) ---
# Provider: anthropic | openai-compatible. Unset, the chat says it isn't configured.
# MEMBER_APP_MODEL_PROVIDER=anthropic
# Model id for that provider.
# MEMBER_APP_MODEL=claude-opus-5-5
# Read by the anthropic provider.
# ANTHROPIC_API_KEY=
# Z.ai GLM (OpenAI-compatible):
#   MEMBER_APP_MODEL_PROVIDER=openai-compatible
#   MEMBER_APP_MODEL_BASE_URL=https://api.z.ai/api/paas/v4
#   MEMBER_APP_MODEL=glm-4.7
#   MEMBER_APP_MODEL_API_KEY=<your z.ai key>
# A Coding Plan key uses https://api.z.ai/api/coding/paas/v4 instead.
# Cheaper model for reading uploads and other background work (same provider).
# Falls back to MEMBER_APP_MODEL when unset.
# MEMBER_APP_FAST_MODEL=glm-4.7-flash
# For other openai-compatible servers (e.g. a local model):
# MEMBER_APP_MODEL_BASE_URL=http://localhost:11434/v1
# MEMBER_APP_MODEL_API_KEY=
# Tests and e2e only: a scripted model, refused when NODE_ENV=production.
# MEMBER_APP_MODEL_PROVIDER=mock
