# Inertia member app: environment variables.
# Copy to .env.local (git-ignored) and uncomment what you need. Every variable
# is optional for local development; commented values are the defaults or examples.

# --- Database ---
# A Postgres URL switches the app to node-postgres. Leave unset to use local PGlite.
# Everything lives in the member_app schema (migration journal included). On a shared
# database the role needs only CONNECT and a member_app schema it owns. Add
# ?sslmode=require for a remote server. See docs/demo/connect-morning.md.
# DATABASE_URL=postgresql://user:password@localhost:5432/inertia
# PGlite directory, used only when DATABASE_URL is unset.
# MEMBER_APP_PGLITE_DIR=data/pglite

# --- Login ---
# Base URL put into login links.
# MEMBER_APP_BASE_URL=http://localhost:3000
# Where the development mailer writes each login link, as <email>.txt.
# MEMBER_APP_MAIL_DIR=data/dev-mail
# How sign-in links reach people: dev (write to MEMBER_APP_MAIL_DIR) or none (admins
# copy one-time links from Organization → Members). Default: none in production, dev otherwise.
# MEMBER_APP_MAILER=none

# --- Adapters and member sync ---
# Which adapter set backs the outside systems:
#   fixture  synthetic DAO for development (default outside production)
#   live     a real organization: members managed in the app, meetings from uploads,
#            work in Paperclip when PAPERCLIP_* is set (otherwise in process memory).
#            The default when NODE_ENV=production.
# MEMBER_APP_ADAPTERS=fixture
# On a fresh install, this email becomes the first admin and runs the setup conversation.
# MEMBER_APP_FOUNDER_EMAIL=you@example.org

# --- Work engine: Paperclip (live mode) ---
# PAPERCLIP_URL=https://paperclip.example.org
# Where members open Paperclip, when PAPERCLIP_URL is an internal address (e.g. a Docker network name).
# PAPERCLIP_PUBLIC_URL=https://paperclip.example.org
# A board API key for the company (Paperclip: board API keys).
# PAPERCLIP_API_KEY=
# PAPERCLIP_COMPANY_ID=
# Label that marks work for a person (created if missing). Default: human
# PAPERCLIP_HUMAN_LABEL=human
# Agent that picks up new agent tasks, usually the CEO. Unset leaves them for Paperclip to route.
# PAPERCLIP_DEFAULT_AGENT_ID=
# read (default): show Paperclip's initiatives and tasks, keep claims in Inertia, write nothing.
# write: also create initiatives and tasks, and assign claims and send answers back to Paperclip.
# A board key carries its issuer's permissions, so give it a user with no more access than this needs.
# PAPERCLIP_ACCESS=read

# --- Integrations pushing data in (e.g. a Telegram bot) ---
# Bearer token for POST /api/org/ingest with JSON { kind, title, text, origin }.
# kind: chat-export | meeting | note | document | link. Unset turns the endpoint off.
# MEMBER_APP_INGEST_TOKEN=

# --- Connectors (scripts/connectors.ts) ---
# Telegram bot from @BotFather (/setprivacy → Disable so it sees group messages).
# TELEGRAM_BOT_TOKEN=
# Only these chat ids (comma-separated); empty reads every chat the bot is in.
# TELEGRAM_CHAT_IDS=
# Buzz relay, a reader identity's hex secret key, and channel UUIDs to read.
# BUZZ_RELAY_URL=https://buzz.example.org
# BUZZ_READER_SECRET_KEY=
# BUZZ_CHANNEL_IDS=
# Optional JSON maps for readable digests: {"<pubkey>":"Kyle"} and {"<channel uuid>":"general"}
# BUZZ_NAMES=
# BUZZ_CHANNEL_NAMES=
# Minutes between deliveries, and where the connector keeps its read position.
# CONNECTOR_FLUSH_MINUTES=15
# CONNECTOR_STATE_FILE=data/connectors.json

# --- Funding (live mode) ---
# Grant finder output as JSON: { "opportunities": [...], "applications": [...] }
# MEMBER_APP_FUNDING_FILE=data/funding.json
# Minutes between member syncs from the directory while the server runs.
# MEMBER_SYNC_INTERVAL_MINUTES=15

# --- Shares ---
# Set to "off" to skip fetching link previews (e2e does this).
# MEMBER_APP_LINK_PREVIEWS=on

# --- Language model (Vercel AI SDK; the provider is swappable) ---
# One switch for everything that uses a model: the chat, and the data processing
# (meeting transcripts and uploads, Find work, the profile, Pursue).
# Provider: anthropic | openai-compatible. Unset, the chat says it isn't configured.
# MEMBER_APP_MODEL_PROVIDER=anthropic
# Model id for that provider.
# MEMBER_APP_MODEL=claude-opus-5-5
# Read by the anthropic provider (MEMBER_APP_MODEL_API_KEY works too).
# ANTHROPIC_API_KEY=
# With anthropic, a faster model for the data processing:
# MEMBER_APP_FAST_MODEL=claude-haiku-5-5
# Z.ai GLM (OpenAI-compatible):
#   MEMBER_APP_MODEL_PROVIDER=openai-compatible
#   MEMBER_APP_MODEL_BASE_URL=https://api.z.ai/api/paas/v4
#   MEMBER_APP_MODEL=glm-4.7
#   MEMBER_APP_MODEL_API_KEY=<your z.ai key>
# A Coding Plan key uses https://api.z.ai/api/coding/paas/v4 instead.
# Cheaper model for reading meetings, uploads and other background work (same provider).
# Used for everything when unset; when set and it can't answer, the work falls back
# to MEMBER_APP_MODEL.
# MEMBER_APP_FAST_MODEL=glm-4.7-flash
# Turn off step-by-step reasoning for background calls on GLM (faster, cheaper).
# MEMBER_APP_MODEL_THINKING=off
# For other openai-compatible servers (e.g. a local model):
# MEMBER_APP_MODEL_BASE_URL=http://localhost:11434/v1
# MEMBER_APP_MODEL_API_KEY=
# Tests and e2e only: a scripted model, refused when NODE_ENV=production.
# MEMBER_APP_MODEL_PROVIDER=mock

# Optional read-only machine interface for organization-shared source evidence.
# Distinct from MEMBER_APP_INGEST_TOKEN and Paperclip/member sign-in credentials.
# Missing means /api/org/knowledge denies all requests. Operator supplies it privately.
# MEMBER_APP_KNOWLEDGE_READ_TOKEN=
