# Settings for docker-compose.yml. Copy to .env at the repo root (git-ignored), chmod 600.
# App settings (Paperclip, Buzz, model keys) go in apps/member/.env.production instead.

# Public hostname. Caddy gets an HTTPS certificate for it, and login links use it.
# Before there is a domain: <ip-with-dashes>.sslip.io. Locally: localhost.
DOMAIN=localhost

# Postgres password for the inertia user: openssl rand -hex 24
POSTGRES_PASSWORD=

# Where nightly database dumps go (14 days kept).
# BACKUP_DIR=./backups
