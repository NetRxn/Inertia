{
  "name": "@inertia/dao-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "demo": "npm run build && node dist/examples/connected-demo.js",
    "demo:transport": "npm run build && node dist/examples/buzz-dry-run.js",
    "prepack": "npm run build",
    "test:package": "node scripts/verify-package.mjs",
    "demo:roundtable": "npm run build && node dist/examples/roundtable-dry-run.js",
    "demo:workflow": "npm run build && node dist/examples/workflow-demo.js"
  },
  "dependencies": {
    "@helix-db/helix-db": "3.1.0",
    "@paperclipai/plugin-sdk": "2026.1012.0",
    "nostr-tools": "2.25.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@helix-db/helix-db-embedded": "0.3.3",
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "paperclipPlugin": {
    "manifest": "./dist/src/manifest.js",
    "worker": "./dist/src/worker.js"
  },
  "files": [
    "dist/src/",
    "migrations/*.sql",
    "docs/operations.md",
    "docs/bridge-state-contract.md",
    "docs/native-comment-mirroring.md",
    "docs/native-public-drafting.md",
    "README.md",
    "LICENSE"
  ]
}
